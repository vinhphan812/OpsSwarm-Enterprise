# OpsSwarm Docker Compose — environment variables
#
# Copy this file to .env (gitignored) and fill in your values:
#   cp .env.compose.example .env
#
# All variables have safe defaults; examples marked [REQUIRED] are required only
# when starting a real service. This file deliberately contains no credentials and
# is the committed baseline used by `docker compose config` in clean clones.

# ── OpsSwarm image ──────────────────────────────────────────────────────────────
# Override the default opsswarm/opsswarm:local tag.
# OPSWARM_IMAGE=your-registry/opsswarm:v2.2.0

# ── OpenClaw binary [REQUIRED if not using --profile openclaw] ───────────────
# Absolute path to the OpenClaw binary on the host machine.
# When using --profile openclaw (OpenClaw sidecar), leave this empty and set
# OPENCLAW_IMAGE instead.
OPSWARM_OPENCLAW_BIN=/usr/local/bin/openclaw

# ── GitHub token file [REQUIRED] ──────────────────────────────────────────────
# Path on the HOST where the GitHub PAT file is stored.
# Create the file with: echo -n "ghp_your_token" > .github-token && chmod 0600 .github-token
GITHUB_TOKEN_FILE_HOST=.github-token

# ── GitHub token (env fallback — prefer the file above) ───────────────────────
# Set this only if you are not using GITHUB_TOKEN_FILE.
# GITHUB_TOKEN=ghp_your_token_here

# ── OpsSwarm configuration ─────────────────────────────────────────────────────
# Path to the config file inside the container.
# Do not change unless you mount a custom config volume.
# OPSWARM_CONFIG=config/production.yaml

# ── Port ───────────────────────────────────────────────────────────────────────
OPSWARM_PORT=8080

# ── OpenClaw sidecar (use with --profile openclaw) ────────────────────────────
# Image tag for the optional OpenClaw sidecar service.
# Build OpenClaw first or replace with a pre-built image.
# OPENCLAW_IMAGE=openclaw:latest

# ── Env file passthrough ───────────────────────────────────────────────────────
# Tell compose to also load the project's .env (e.g. for OPSWARM_PROFILE).
# Set to .env to include the project .env alongside this compose .env.
# OPSWARM_ENV_FILE=.env
