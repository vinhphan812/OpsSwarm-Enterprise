# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=
VERTEX_AI_LOCATION=

# Gemini
GEMINI_MODEL=

# Firestore
FIRESTORE_DATABASE=(default)

# Pub/Sub
STORE_EVENTS_TOPIC=store-events

# BigQuery
BIGQUERY_DATASET=retailtwin

# Application
API_BASE_URL=http://localhost:8000
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORE_ID=store-001

# Web client. Copy to apps/web/.env.local if you change the API origin.
VITE_API_BASE_URL=http://127.0.0.1:8000
