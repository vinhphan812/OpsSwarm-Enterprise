# Google Cloud. Non-secret ids only. Do not put a service-account key here.
# Project retailtwin-ai has no billing. cn-prj-17cd4 is a different product.
# Stay inside the always-free limits in infrastructure/gcp/README.md.
GCP_PROJECT_ID=retailtwin-ai-511002
GCP_REGION=us-central1
VERTEX_AI_LOCATION=us-central1

# Gemini. Leave empty until issue #2. Vertex AI calls are not on the always-free list.
GEMINI_MODEL=

# Firestore. Standard edition, Native mode, the one free-tier database.
# Live Twin documents stay with issue #6. store_event_claims is the event-id ledger.
FIRESTORE_DATABASE=(default)

# Pub/Sub. Message storage is limited to us-central1.
STORE_EVENTS_TOPIC=store-events
STORE_EVENTS_SUBSCRIPTION=store-events-analytics

# BigQuery. On-demand dataset. No reservation.
BIGQUERY_DATASET=retailtwin
BIGQUERY_LOCATION=us-central1

# Empty day-0 resources. Cloud Storage free tier applies in us-central1.
GCS_BUCKET=retailtwin-ai-511002-assets
ARTIFACT_REGISTRY_REPO=retailtwin
ARTIFACT_REGISTRY_LOCATION=us-central1

# Runtime identities. No JSON keys are created for these accounts.
API_SERVICE_ACCOUNT=retailtwin-api@retailtwin-ai-511002.iam.gserviceaccount.com
AGENT_SERVICE_ACCOUNT=retailtwin-agent@retailtwin-ai-511002.iam.gserviceaccount.com

# Application
API_BASE_URL=http://localhost:8000
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORE_ID=store-001
# memory: in-process Live Twin seeded from the fixture. firestore: Firestore Live Twin. fixture: read-only.
LIVE_TWIN_BACKEND=memory

# Decision Context Guard and commit authorization (ADR 0014-0016)
# RETAILTWIN_COMMIT_SIGNING_KEY=        # Required in production; outside it a per-process key is generated
# RETAILTWIN_COMMIT_TOKEN_TTL_SECONDS=30
# RETAILTWIN_DCG_FRESHNESS_SECONDS=120
# RETAILTWIN_DCG_MAX_FACINGS=12
# RETAILTWIN_DCG_MAX_ACTIONS=5
# RETAILTWIN_DCG_MAX_REPLENISH_UNITS=200

# ── Cloud Run production overrides (set APP_ENV=production) ───────────────────
# LOG_LEVEL=INFO          # Default; set to WARNING in production for less noise
# STORE_FIXTURE_PATH=     # Path inside the container; default is data/schemas/store-state.example.json
# STARTUP_TIMEOUT_SECONDS=240  # Must match gcloud --timeout flag

# Web client. Copy to apps/web/.env.local if you change the API origin.
VITE_API_BASE_URL=http://127.0.0.1:8000
