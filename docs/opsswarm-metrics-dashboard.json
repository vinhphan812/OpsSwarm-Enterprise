          "editorMode": "code",
          "expr": "investigate_seconds_sum / investigate_seconds_count",
          "instant": false,
          "legendFormat": "investigate",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "verify_seconds_sum / verify_seconds_count",
          "hide": false,
          "instant": false,
          "legendFormat": "verify",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Phase Durations (avg per run)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
