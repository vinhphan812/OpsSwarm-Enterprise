{
  agents: {
    defaults: {
      skipBootstrap: true,
      timeoutSeconds: 600,
    },
    entries: {
      "opsswarm-incident-manager": {
        workspace: "REPLACE_WITH_ABSOLUTE_REPO_PATH/openclaw/workspaces/opsswarm-incident-manager",
        tools: {
          allow: [
            "read",
            "write"
          ]
        }
      },
      "opsswarm-observability-investigator": {
        workspace: "REPLACE_WITH_ABSOLUTE_REPO_PATH/openclaw/workspaces/opsswarm-observability-investigator",
        tools: {
          allow: [
            "read"
          ]
        }
      },
      "opsswarm-application-investigator": {
        workspace: "REPLACE_WITH_ABSOLUTE_REPO_PATH/openclaw/workspaces/opsswarm-application-investigator",
        tools: {
          allow: [
            "read"
          ]
        }
      },
      "opsswarm-infrastructure-investigator": {
        workspace: "REPLACE_WITH_ABSOLUTE_REPO_PATH/openclaw/workspaces/opsswarm-infrastructure-investigator",
        tools: {
          allow: [
            "read"
          ]
        }
      },
      "opsswarm-database-investigator": {
        workspace: "REPLACE_WITH_ABSOLUTE_REPO_PATH/openclaw/workspaces/opsswarm-database-investigator",
        tools: {
          allow: [
            "read"
          ]
        }
      },
      "opsswarm-recovery-responder": {
        workspace: "REPLACE_WITH_ABSOLUTE_REPO_PATH/openclaw/workspaces/opsswarm-recovery-responder",
        tools: {
          allow: [
            "read",
            "write",
            "apply_patch"
          ]
        }
      },
      "opsswarm-communications-postmortem": {
        workspace: "REPLACE_WITH_ABSOLUTE_REPO_PATH/openclaw/workspaces/opsswarm-communications-postmortem",
        tools: {
          allow: [
            "read"
          ]
        }
      },
    },
  },
  skills: {
    load: {
      extraDirs: [
        "REPLACE_WITH_ABSOLUTE_REPO_PATH/skills"
      ],
    },
  },
}
